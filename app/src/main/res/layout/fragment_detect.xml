<?xml version="1.0" encoding="utf-8"?>
<!-- 环境检测页：按 b42df36 原设计还原（紫色 #4A148C 标题、浅紫 #F3E5F5 状态框、
     16dp 圆角 + 4dp 阴影的 MaterialCardView、#F5F5F5 页面底色）。
     根节点由原版的 NestedScrollView 改为 LinearLayout：安全页宿主本身已是
     NestedScrollView，再嵌套会导致滚动冲突与滑动手势被吞；“整改建议”卡为本版新增，
     沿用同一套设计语言。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="16dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Root 检测"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#4A148C"
                android:layout_marginBottom="16dp" />

            <TextView
                android:id="@+id/tvRootStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="正在检测..."
                android:textSize="16sp"
                android:padding="12dp"
                android:background="#F3E5F5"
                android:textColor="#4A148C"
                android:gravity="center" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="基线检测"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4A148C"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/layoutRootBeerDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检测详情"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4A148C"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/layoutDetectionDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardDetectAdvice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="整改建议"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#4A148C"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:id="@+id/layoutDetectAdvice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
