<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ios_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnKpmBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:src="@drawable/ic_explore"
            app:tint="@color/ios_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="KPM 刷写"
            android:textColor="@color/ios_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnKpmPick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="选择文件"
            android:textColor="@color/ios_accent"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnKpmRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:text="刷新"
            android:textColor="@color/ios_accent"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- 环境卡片：先告诉用户这台机器到底能不能刷 KPM -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="4dp"
        app:cardBackgroundColor="@color/ios_card"
        app:cardCornerRadius="@dimen/ios_card_corner"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="环境"
                android:textColor="@color/ios_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvKpmEnvRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ROOT：检测中…"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvKpmEnvApatch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="KernelPatch / APatch：检测中…"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvKpmEnvDir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="模块目录：检测中…"
                android:textColor="@color/ios_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvKpmEnvHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="2dp"
                android:text="说明：本页的「刷入」= 把 .kpm 放到 /data/adb/ap/kpm/&lt;id&gt;/&lt;id&gt;.kpm，由 APatch 开机时加载，需重启生效。运行时热加载走 KernelPatch supercall，需要 APatch 的 superkey，第三方应用拿不到，请在 APatch 内操作。"
                android:textColor="@color/explore_slate_500"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvKpm"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="16dp" />

        <ProgressBar
            android:id="@+id/pbKpm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvKpmEmpty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="暂无 KPM，点右上角「选择文件」刷入"
            android:textColor="@color/ios_text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
